{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Hezarani/odontoage/schema/method.schema.json",
  "title": "OdontoAge method family file",
  "type": "object",
  "required": ["family", "methods"],
  "properties": {
    "family": { "type": "string" },
    "family_label": { "type": "string" },
    "schema_version": { "type": "string" },
    "methods": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "label", "family", "kind", "dentition", "source", "verified"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "family": { "type": "string" },
          "kind": { "enum": ["regression", "maturity_score", "direct_age"] },
          "dentition": { "enum": ["developing", "adult"] },
          "measurement": { "enum": ["staging", "open_apices", "pulp_tooth_area", "pulp_tooth_ratio"] },
          "sex_required": { "type": "boolean" },
          "age_range_years": {
            "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
          },
          "prediction_error_years": { "type": ["number", "null"] },
          "regression": {
            "type": "object",
            "properties": {
              "intercept": { "type": ["number", "null"] },
              "terms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["var", "coef"],
                  "properties": {
                    "var": { "type": "string" },
                    "coef": { "type": ["number", "null"] },
                    "desc": { "type": "string" }
                  }
                }
              }
            }
          },
          "teeth": { "type": "array", "items": { "type": "string" } },
          "stages": { "type": "array", "items": { "type": "string" } },
          "scores": { "type": "object" },
          "tables": { "type": "object" },
          "conversion": { "type": "object" },
          "equations": { "type": "object" },
          "source": { "type": "string" },
          "verified": { "type": "boolean" },
          "status": { "type": "string" },
          "verification_note": { "type": "string" }
        }
      }
    }
  }
}
